{
  "name": "toolbox-monorepo",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter frontend --filter backend dev",
    "dev:web": "pnpm --filter frontend dev",
    "dev:api": "pnpm --filter backend dev",
    "dev:ai": ".venv-image-ai\\Scripts\\python.exe scripts\\image-ai-worker.py",
    "build": "pnpm build:shared && pnpm build:backend && pnpm build:web && pnpm smoke",
    "build:shared": "pnpm --filter @toolbox/shared build",
    "build:backend": "pnpm --filter backend build",
    "build:web": "pnpm --filter frontend build && node scripts/check-bundle-budget.mjs",
    "clean": "node scripts/clean.mjs",
    "clear:generated": "node scripts/clear-generated.mjs",
    "smoke": "node scripts/smoke-build.mjs",
    "smoke:standalone": "node scripts/smoke-standalone.mjs",
    "start": "pnpm --filter backend start",
    "preview:web": "pnpm --filter frontend preview",
    "desktop:stage": "node apps/desktop/scripts/stage-resources.mjs",
    "desktop:icons": "pnpm --filter backend exec node scripts/generate-desktop-icon-assets.mjs",
    "desktop:rebuild-native": "node apps/desktop/scripts/stage-resources.mjs --rebuild-native",
    "desktop:build": "pnpm build:shared && pnpm build:backend && pnpm build:web && pnpm desktop:stage && pnpm --filter desktop build",
    "desktop:start": "pnpm desktop:build && pnpm --filter desktop start",
    "desktop:package": "pnpm desktop:build && pnpm desktop:rebuild-native && pnpm --filter desktop package",
    "desktop:make": "pnpm desktop:build && pnpm desktop:rebuild-native && pnpm --filter desktop make",
    "components:package": "node scripts/build-component-package.mjs",
    "components:catalog": "node scripts/assemble-component-catalog.mjs",
    "components:prepare-python-311": "node scripts/prepare-python-311-runtime.mjs",
    "components:prepare-python-312": "node scripts/prepare-python-312-runtime.mjs",
    "components:prepare-xhs-archive": "node scripts/prepare-xhs-archive-component.mjs",
    "components:prepare-xhs-translation": "node scripts/prepare-xhs-translation-component.mjs",
    "components:prepare-xhs-browser": "node scripts/prepare-xhs-browser-component.mjs",
    "components:test-xhs-translation-smoke": "node scripts/test-xhs-translation-smoke.mjs",
    "components:test-xhs-lifecycle": "pnpm --filter backend exec tsx ../scripts/test-xhs-capability-lifecycle.mjs",
    "components:lock-xhs-dependencies": "pwsh -NoProfile -File scripts/lock-xhs-dependencies.ps1",
    "components:prepare-edge-tts": "node scripts/prepare-edge-tts-component.mjs",
    "components:prepare-image-ai": "node scripts/prepare-image-ai-component.mjs",
    "components:prepare-chatterbox": "node scripts/prepare-chatterbox-component.mjs",
    "components:prepare-video-text": "node scripts/prepare-video-text-component.mjs",
    "components:prepare-whisper-small": "node scripts/prepare-whisper-small-model.mjs",
    "standalone:start": "node scripts/start-standalone.mjs",
    "db:migrate": "pnpm --filter backend exec tsx src/database/cli.ts migrate",
    "db:verify": "pnpm --filter backend exec tsx src/database/cli.ts verify",
    "db:benchmark": "pnpm --filter backend exec tsx src/database/benchmark.ts",
    "db:rollback": "pnpm --filter backend exec tsx src/database/cli.ts rollback",
    "test": "pnpm --workspace-concurrency=1 -r test",
    "coverage": "pnpm --workspace-concurrency=1 -r coverage",
    "prepare:xhs-model": "node scripts/prepare-xhs-translation-model.mjs",
    "lock:python": "pwsh -NoProfile -File scripts/lock-worker-dependencies.ps1",
    "audit:python": "python scripts/audit-worker-dependencies.py",
    "coverage:diff": "node scripts/check-diff-coverage.mjs",
    "test:python": "python -m pytest",
    "test:scripts": "node --test scripts/cleanup-engine.test.mjs scripts/check-diff-coverage.test.mjs scripts/worker-locks.test.mjs scripts/build-component-package.test.mjs scripts/component-preparation.test.mjs scripts/image-ai-component-preparation.test.mjs scripts/chatterbox-component-preparation.test.mjs scripts/desktop-icon-assets.test.mjs",
    "test:diff-coverage": "node --test scripts/check-diff-coverage.test.mjs",
    "test:e2e": "playwright test",
    "lint:python": "python -m ruff format --check scripts && python -m ruff check scripts && python -m mypy",
    "test:all": "pnpm test && pnpm test:python && pnpm test:scripts && pnpm test:diff-coverage",
    "typecheck": "pnpm --workspace-concurrency=1 -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "deadcode": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm deadcode && pnpm typecheck && pnpm test:all && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.13.4",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^16.5.0",
    "knip": "^5.88.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
