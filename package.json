{
  "name": "toolbox-monorepo",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter frontend --filter backend dev",
    "dev:web": "pnpm --filter frontend dev",
    "dev:api": "pnpm --filter backend dev",
    "dev:ai": ".venv-image-ai\\Scripts\\python.exe scripts\\image-ai-worker.py",
    "build": "pnpm build:shared && pnpm build:backend && pnpm build:web && pnpm smoke",
    "build:shared": "pnpm --filter @toolbox/shared build",
    "build:backend": "pnpm --filter backend build",
    "build:web": "pnpm --filter frontend build && node scripts/check-bundle-budget.mjs",
    "clean": "node scripts/clean.mjs",
    "clear:generated": "node scripts/clear-generated.mjs",
    "smoke": "node scripts/smoke-build.mjs",
    "smoke:standalone": "node scripts/smoke-standalone.mjs",
    "start": "pnpm --filter backend start",
    "preview:web": "pnpm --filter frontend preview",
    "standalone:start": "node scripts/start-standalone.mjs",
    "db:migrate": "pnpm --filter backend exec tsx src/database/cli.ts migrate",
    "db:verify": "pnpm --filter backend exec tsx src/database/cli.ts verify",
    "db:benchmark": "pnpm --filter backend exec tsx src/database/benchmark.ts",
    "db:rollback": "pnpm --filter backend exec tsx src/database/cli.ts rollback",
    "test": "pnpm --workspace-concurrency=1 -r test",
    "coverage": "pnpm --workspace-concurrency=1 -r coverage",
    "prepare:xhs-model": "node scripts/prepare-xhs-translation-model.mjs",
    "lock:python": "pwsh -NoProfile -File scripts/lock-worker-dependencies.ps1",
    "audit:python": "python scripts/audit-worker-dependencies.py",
    "coverage:diff": "node scripts/check-diff-coverage.mjs",
    "test:python": "python -m pytest",
    "test:diff-coverage": "node --test scripts/check-diff-coverage.test.mjs",
    "test:e2e": "playwright test",
    "lint:python": "python -m ruff format --check scripts && python -m ruff check scripts && python -m mypy",
    "test:all": "pnpm test && pnpm test:python && pnpm test:diff-coverage",
    "typecheck": "pnpm --workspace-concurrency=1 -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "deadcode": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm deadcode && pnpm typecheck && pnpm test:all && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "knip": "^6.35.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0"
  }
}
