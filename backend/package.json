    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "10.1.3",
    "@fastify/type-provider-typebox": "5.2.0",
    "@toolbox/shared": "workspace:*",
    "archiver": "^8.0.0",
    "better-sqlite3": "13.0.3",
    "fastify": "^5.12.4",
    "nanoid": "^5.1.16",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.4",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/better-sqlite3": "^7.6.13",
