{
  "name": "@toolbox/shared",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./video-text": {
      "types": "./dist/video-text.d.ts",
      "import": "./dist/video-text.js"
    },
    "./edge-tts": {
      "types": "./dist/edge-tts.d.ts",
      "import": "./dist/edge-tts.js"
    },
    "./chatterbox": {
      "types": "./dist/chatterbox.d.ts",
      "import": "./dist/chatterbox.js"
    },
    "./short-video": {
      "types": "./dist/short-video.d.ts",
      "import": "./dist/short-video.js"
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "opencc-js": "^1.4.2"
  }
}
