{
  "name": "@toolbox/shared",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./common": {
      "types": "./dist/common.d.ts",
      "import": "./dist/common.js"
    },
    "./system": {
      "types": "./dist/system.d.ts",
      "import": "./dist/system.js"
    },
    "./speech": {
      "types": "./dist/speech.d.ts",
      "import": "./dist/speech.js"
    },
    "./archive": {
      "types": "./dist/archive.d.ts",
      "import": "./dist/archive.js"
    },
    "./lan": {
      "types": "./dist/lan.d.ts",
      "import": "./dist/lan.js"
    },
    "./audio-library": {
      "types": "./dist/audio-library.d.ts",
      "import": "./dist/audio-library.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "import": "./dist/image.js"
    },
    "./desktop": {
      "types": "./dist/desktop.d.ts",
      "import": "./dist/desktop.js"
    },
    "./edge-tts": {
      "types": "./dist/edge-tts.d.ts",
      "import": "./dist/edge-tts.js"
    },
    "./chatterbox": {
      "types": "./dist/chatterbox.d.ts",
      "import": "./dist/chatterbox.js"
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52"
  }
}
