{
  "ignoreBinaries": ["python", "pwsh"],
  "ignoreDependencies": ["electron-builder", "tslib"],
  "playwright": { "config": ["playwright.config.ts", "playwright.styles.config.ts"] },
  "workspaces": {
    ".": {
      "entry": [
        "scripts/smoke-audio-library.mjs",
        "scripts/bootstrap-components.ts",
        "scripts/check-source-native.mjs",
        "tooling/build/package-desktop.mjs",
        "tooling/testing/smoke-installed-desktop.mjs"
      ]
    },
    "apps/api": {
      "entry": [
        "src/database/cli.ts",
        "src/database/benchmark.ts",
        "src/diagnostics-cli.ts",
        "scripts/generate-desktop-icon-assets.mjs"
      ]
    },
    "apps/desktop": {
      "entry": ["src/preload.ts", "scripts/*.mjs"]
    }
  }
}
