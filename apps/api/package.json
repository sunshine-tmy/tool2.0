    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "10.1.7",
    "@fastify/type-provider-typebox": "6.3.0",
    "@sinclair/typebox": "^0.34.52",
    "@toolbox/runtime-core": "workspace:*",
    "@toolbox/shared": "workspace:*",
    "archiver": "^8.0.0",
    "better-sqlite3": "13.0.3",
    "fast-xml-parser": "5.11.2",
    "fastify": "^5.12.7",
    "music-metadata": "^12.2.3",
    "nanoid": "^6.0.2",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "tar": "^7.5.7",
    "undici": "^8.12.3",
    "yauzl": "^3.4.0"
