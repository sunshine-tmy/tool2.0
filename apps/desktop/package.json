{
  "name": "desktop",
  "private": true,
  "version": "0.1.8",
  "author": "Ecommerce Toolbox",
  "type": "module",
  "productName": "Ecommerce Toolbox",
  "description": "Ecommerce Toolbox desktop application",
  "main": "dist/main.js",
  "dependencies": {
    "@toolbox/runtime-core": "workspace:*",
    "electron-updater": "6.8.9",
    "tslib": "2.8.1"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsup src/preload.ts --format cjs --platform node --target node24 --out-dir dist --clean false",
    "start": "electron .",
    "package": "node scripts/package-desktop.mjs",
    "make": "node scripts/package-desktop.mjs --make",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude .stage/** --exclude out/** --exclude scripts/** && node --test scripts/smoke-installed-desktop.test.mjs",
    "test:installed-smoke": "node --test scripts/smoke-installed-desktop.test.mjs"
  },
  "devDependencies": {
    "@toolbox/shared": "workspace:*",
    "@electron/packager": "^20.3.0",
    "@electron/rebuild": "^4.2.1",
    "electron": "^45.1.0",
    "electron-builder": "26.18.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
