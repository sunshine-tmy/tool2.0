# API binds to loopback by default. The Vite development server proxies /api,
# so LAN clients can still use the frontend without exposing the API port directly.
API_HOST=127.0.0.1
API_PORT=3100
# local binds to loopback. lan binds to all interfaces and requires ADMIN_PIN.
DEPLOYMENT_MODE=local
ADMIN_PIN=

# Leave empty for same-origin /api requests. Set an absolute URL only when the
# frontend and API are intentionally deployed on different origins.
VITE_API_BASE=
VITE_API_PROXY_TARGET=http://127.0.0.1:3100
# Comma-separated exact browser origins allowed to call the API directly.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

STORAGE_ROOT=./storage
# Optional override. The default is storage/toolbox.db.
DATABASE_PATH=
LAN_TRANSFER_MAX_FILE_BYTES=21474836480
LAN_TRANSFER_RETENTION_DAYS=3
LAN_TRANSFER_UPLOAD_RETENTION_HOURS=24
LAN_TRANSFER_CLEANUP_INTERVAL_MINUTES=15
LAN_TRANSFER_MAX_STORAGE_BYTES=107374182400
LAN_TRANSFER_WEB_PORT=5173
# Optional. Set this together with a restricted guest mode to protect management actions.
LAN_TRANSFER_PIN=
# full | upload-only | download-only | disabled
LAN_TRANSFER_GUEST_MODE=full

# Remote media proxy/download safety limits.
REMOTE_FETCH_TIMEOUT_MS=120000
REMOTE_MEDIA_MAX_BYTES=2147483648

# Audio extraction command. Placeholders are passed as individual process
# arguments without a shell: {input}/{video}, {output}/{audio}.
VIDEO_TEXT_AUDIO_EXTRACT_COMMAND=ffmpeg -y -i {input} -vn -acodec pcm_s16le -ar 16000 -ac 1 {output}
# Install the optional transcriber with scripts/setup-video-text.ps1, then set:
# .venv-video-text/Scripts/python.exe scripts/video-transcribe-faster-whisper.py --input {input} --output {output} --model large-v3-turbo --language zh --device cuda --compute-type int8_float16
VIDEO_TEXT_TRANSCRIBE_COMMAND=

# Third-party short-video parser. Replace this endpoint with a compatible
# provider you trust; submitted share URLs are sent to that provider.
SHORT_VIDEO_PARSE_API_URL=https://api.bugpk.com/api/short_videos
SHORT_VIDEO_PARSE_TIMEOUT_MS=20000
SHORT_VIDEO_CACHE_TTL_MS=300000
SHORT_VIDEO_PARSE_RETRIES=1
SHORT_VIDEO_TIKTOK_OEMBED_FALLBACK=true
SHORT_VIDEO_XHS_LOCAL_FALLBACK=true

# Xiaohongshu archive. Leave XHS_PROVIDER_URL empty to lazily install the
# pinned local XHS-Downloader adapter into .runtime on first use.
XHS_PROVIDER_URL=
XHS_PROVIDER_PORT=5556
XHS_INSTALL_TIMEOUT_MS=1200000
XHS_ARCHIVE_MAX_STORAGE_BYTES=107374182400

# Local Chinese-to-English translation (CPU only). The model is downloaded lazily and never committed.
XHS_TRANSLATION_RUNTIME_DIR=.runtime/xhs-translate
XHS_TRANSLATION_MODEL_DIR=.runtime/xhs-translate/model
XHS_TRANSLATION_PROVIDER_URL=
XHS_TRANSLATION_PROVIDER_PORT=5557
XHS_TRANSLATION_INSTALL_TIMEOUT_MS=1200000
XHS_TRANSLATION_MODEL_URL=https://github.com/sunshine-tmy/tool2.0/releases/download/xhs-translation-v1/opus-mt-zh-en-ct2-int8-cf109095.tar.gz
# XHS_TRANSLATION_MODEL_SHA256=
# 若默认 Release Asset 尚未发布，程序会自动切换到固定提交的 Hugging Face 预转换恢复源。

# Edge-TTS uses Microsoft's online speech service. The default runtime is
# installed by scripts/setup-edge-tts.ps1 and does not require an API key.
EDGE_TTS_PYTHON=.venv-edge-tts/Scripts/python.exe
EDGE_TTS_SCRIPT=scripts/edge-tts-generate.py
EDGE_TTS_TIMEOUT_MS=180000
EDGE_TTS_RETENTION_DAYS=3
EDGE_TTS_QUEUE_LIMIT=20
EDGE_TTS_CONCURRENCY=2

# Chatterbox Multilingual V3 runs locally in an isolated Python 3.11 worker.
# Install once with: scripts/setup-chatterbox.ps1 -DownloadModel
CHATTERBOX_WORKER_URL=http://127.0.0.1:3220
CHATTERBOX_WORKER_HOST=127.0.0.1
CHATTERBOX_WORKER_PORT=3220
CHATTERBOX_WORKER_TIMEOUT_MS=1200000
CHATTERBOX_RETENTION_DAYS=3
CHATTERBOX_QUEUE_LIMIT=50
CHATTERBOX_DEVICE=auto
CHATTERBOX_MODEL_IDLE_MINUTES=10
CHATTERBOX_STORAGE_ROOT=./storage/chatterbox
CHATTERBOX_MODELS_ROOT=./models/chatterbox
# 固定 Chatterbox 模型版本；升级前请通过完整配音回归，避免上游 main 分支变更影响本机推理。
CHATTERBOX_MODEL_REVISION=5bb1f6ee58e50c3b8d408bc82a6d3740c2db6e18
CHATTERBOX_FFMPEG_PATH=ffmpeg
CHATTERBOX_FFPROBE_PATH=ffprobe

# AI image processing is local-only. BRIA is permitted only when this is
# explicitly internal-noncommercial; commercial mode forces BiRefNet.
DEPLOYMENT_USAGE=commercial
IMAGE_AI_WORKER_URL=http://127.0.0.1:3210
IMAGE_AI_WORKER_TIMEOUT_MS=300000
IMAGE_AI_RETENTION_HOURS=24
IMAGE_AI_QUEUE_LIMIT=20
IMAGE_AI_STORAGE_ROOT=./storage/image-ai
IMAGE_AI_MODELS_ROOT=./models/image-ai
IMAGE_AI_BRIA_MODEL_DIR=./models/image-ai/RMBG-2.0
IMAGE_AI_BRIA_SHA256=
