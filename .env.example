API_HOST=0.0.0.0
API_PORT=3100
VITE_API_BASE=http://192.168.1.241:3100/api
STORAGE_ROOT=./storage
LAN_TRANSFER_MAX_FILE_BYTES=21474836480
LAN_TRANSFER_RETENTION_DAYS=7
LAN_PUBLIC_BASE_URL=http://192.168.1.241:3100
# Optional audio extraction command. Defaults to ffmpeg when empty.
# Placeholders are automatically quoted: {input} is the uploaded video, {output} is the extracted wav.
VIDEO_TEXT_AUDIO_EXTRACT_COMMAND=ffmpeg -y -i {input} -vn -acodec pcm_s16le -ar 16000 -ac 1 {output}
# Optional local speech-to-text command. It receives extracted audio as {input}/{audio}, original video as {video}, and should write text to {output} or stdout.
# Accuracy-first local GPU example. First run downloads the model; later runs use the local cache.
# The helper automatically falls back through medium, small, and base if the large model cannot load.
# Use --device cpu --compute-type int8 if CUDA is unavailable.
# Example: python F:\git仓库内容\tool2.0\scripts\video-transcribe-faster-whisper.py --input {input} --output {output} --model large-v3-turbo --language zh --device cuda --compute-type int8_float16
VIDEO_TEXT_TRANSCRIBE_COMMAND=

# Short video parser provider. Default uses the verified BugPk aggregate endpoint.
# Replace with your own compatible provider if the public service changes or becomes unavailable.
SHORT_VIDEO_PARSE_API_URL=https://api.bugpk.com/api/short_videos
SHORT_VIDEO_PARSE_TIMEOUT_MS=20000

# AI image processing is local-only. BRIA is only enabled when this is explicitly noncommercial.
# Leave as commercial to force the MIT-licensed BiRefNet provider.
DEPLOYMENT_USAGE=commercial
IMAGE_AI_WORKER_URL=http://127.0.0.1:3210
IMAGE_AI_WORKER_TIMEOUT_MS=300000
IMAGE_AI_RETENTION_HOURS=24
IMAGE_AI_QUEUE_LIMIT=20
# Must resolve to the same image-ai directory used by STORAGE_ROOT.
IMAGE_AI_STORAGE_ROOT=./storage/image-ai
IMAGE_AI_MODELS_ROOT=./models/image-ai
# BRIA is never downloaded automatically; point this at a locally accepted RMBG-2.0 snapshot.
IMAGE_AI_BRIA_MODEL_DIR=./models/image-ai/RMBG-2.0
# Record the approved BRIA weight digest here so health checks do not hash multi-GB files repeatedly.
IMAGE_AI_BRIA_SHA256=
